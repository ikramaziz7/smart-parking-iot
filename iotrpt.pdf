/Type /StructElem
/S /H1
/T (  // Print the measured distance   Serial.print\("Distance: "\);   Serial.print\(distance\);   Serial.println\(" cm"\); // Control LEDs based on measured distance  if \(distance < 8 \) {  digitalWrite\(GledPin, HIGH\); // Turn on green LED if distance is less than 8 cm  digitalWrite\(RledPin, LOW\); // Turn off red LED  digitalWrite\(YledPin, HIGH\); // Turn off yellow LED  Serial.println\("Green LED ON"\);  } else {  digitalWrite\(RledPin, HIGH\); // Turn on red LED if distance is 15 cm or more  digitalWrite\(GledPin, LOW\); // Turn off green LED  digitalWrite\(YledPin, HIGH\); // Turn off yellow LED  Serial.println\("Red LED ON"\);  })
/E (  // Print the measured distance   Serial.print\("Distance: "\);   Serial.print\(distance\);   Serial.println\(" cm"\); // Control LEDs based on measured distance  if \(distance < 8 \) {  digitalWrite\(GledPin, HIGH\); // Turn on green LED if distance is less than 8 cm  digitalWrite\(RledPin, LOW\); // Turn off red LED  digitalWrite\(YledPin, HIGH\); // Turn off yellow LED  Serial.println\("Green LED ON"\);  } else {  digitalWrite\(RledPin, HIGH\); // Turn on red LED if distance is 15 cm or more  digitalWrite\(GledPin, LOW\); // Turn off green LED  digitalWrite\(YledPin, HIGH\); // Turn off yellow LED  Serial.println\("Red LED ON"\);  })
/Pg 35 0 R
/K [3]
>>
